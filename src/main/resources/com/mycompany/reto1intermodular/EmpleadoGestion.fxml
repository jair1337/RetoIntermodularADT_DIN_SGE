<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="18.0" prefWidth="1000.0" prefHeight="560.0" styleClass="content-bg" stylesheets="@/styles/ApartadoLoginCSS.css" xmlns="http://javafx.com/javafx/9.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto1intermodular.EmpleadoGestionController">
   <padding>
      <Insets top="24.0" right="36.0" bottom="24.0" left="36.0" />
   </padding>
   <children>
      <Label text="Mantenimiento de zonas" styleClass="menu-title" />
      <GridPane alignment="CENTER" hgap="14.0" vgap="14.0">
         <children>
            <Label text="Polideportivo" />
            <ComboBox fx:id="polideportivo" onAction="#cargarRecursos" prefWidth="360.0" GridPane.columnIndex="1" GridPane.columnSpan="2" />
            <Label text="Pista, aula o actividad" GridPane.rowIndex="1" />
            <ComboBox fx:id="recurso" prefWidth="360.0" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2" />
            <Label text="Inicio" GridPane.rowIndex="2" />
            <DatePicker fx:id="fechaInicio" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            <TextField fx:id="horaInicio" promptText="HH:mm" prefWidth="90.0" GridPane.rowIndex="2" GridPane.columnIndex="2" />
            <Label text="Fin" GridPane.rowIndex="3" />
            <DatePicker fx:id="fechaFin" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            <TextField fx:id="horaFin" promptText="HH:mm" prefWidth="90.0" GridPane.rowIndex="3" GridPane.columnIndex="2" />
         </children>
      </GridPane>
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Button text="Atrás" onAction="#volver" styleClass="primary-btn" />
            <Button text="Aplicar mantenimiento" onAction="#aplicar" styleClass="primary-btn" />
         </children>
      </HBox>
   </children>
</VBox>