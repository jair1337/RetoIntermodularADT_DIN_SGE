<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.28" prefHeight="560.0" prefWidth="1000.0" stylesheets="@/styles/ApartadoLoginCSS.css" xmlns="http://javafx.com/javafx/9.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto1intermodular.EmpleadoMenuController">
   <items>
      <VBox alignment="CENTER" maxWidth="280.0" prefWidth="260.0" spacing="12.0" styleClass="sidebar">
         <padding>
            <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
         </padding>
         <children>
            <Label text="Usuario" style="-fx-text-fill: white; -fx-font-weight: bold;" />
            <Label text="Rol: Empleado" style="-fx-text-fill: rgba(255,255,255,0.8);" />
            <Button fx:id="btnPerfil" prefWidth="220.0" onAction="#abrirPerfil" styleClass="primary-btn" text="Consultar perfil" />
            <Button fx:id="btnCerrarSesion" prefWidth="220.0" onAction="#cerrarSesion" styleClass="primary-btn" text="Cerrar sesión" />
         </children>
      </VBox>
      <VBox alignment="CENTER" spacing="16.0" styleClass="content-bg">
         <children>
            <Label text="TxandaSport" styleClass="menu-title" />
            <Button prefWidth="240.0" onAction="#abrirGestion" styleClass="primary-btn" text="Gestión de las zonas" />
            <Button prefWidth="240.0" onAction="#abrirHorario" styleClass="primary-btn" text="Ver horario de trabajo" />
         </children>
      </VBox>
   </items>
</SplitPane>