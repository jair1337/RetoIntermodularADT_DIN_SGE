<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto1intermodular.ClienteMenuController">

    <!-- ============ Barra lateral ============ -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="76.0" spacing="14.0" styleClass="sidebar">
            <padding>
                <Insets top="22.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-logo" text="Logo" />
                <Region prefHeight="10.0" />
                <ToggleButton fx:id="btnCasa" selected="true" styleClass="nav-btn" text="🏠" />
                <ToggleButton fx:id="btnPerfil" onAction="#abrirPerfil" styleClass="nav-btn" text="👤" />
                <ToggleButton fx:id="btnPuntosLogros" onAction="#abrirPuntosYLogros" styleClass="nav-btn" text="★" />
                <ToggleButton fx:id="btnCerrarSesion" onAction="#cerrarSesion" styleClass="nav-btn" text="⏻" />
            </children>
        </VBox>
    </left>

    <!-- ============ Contenido ============ -->
    <center>
        <VBox spacing="6.0" styleClass="content-bg">
            <padding>
                <Insets bottom="40.0" left="60.0" right="60.0" top="50.0" />
            </padding>
            <children>
                <Label styleClass="menu-title" text="Menú Principal" />
                <Label styleClass="menu-sub" text="¿Qué quieres hacer?" />
                <Region prefHeight="22.0" />

                <GridPane alignment="CENTER" hgap="26.0" vgap="26.0">
                    <children>
                        <Button fx:id="btnDisponibilidad" onAction="#abrirDisponibilidad" styleClass="menu-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <graphic>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label styleClass="card-icon" text="🏟" />
                                        <Label styleClass="card-text" text="Consultar&#10;disponibilidad" />
                                    </children>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnCancelar" onAction="#abrirCancelar" styleClass="menu-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <graphic>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label styleClass="card-icon" text="🎫" />
                                        <Label styleClass="card-text" text="Consultar&#10;actividades" />
                                    </children>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnContactanos" onAction="#abrirContacto" styleClass="menu-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <graphic>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label styleClass="card-icon" text="📨" />
                                        <Label styleClass="card-text" text="Contactanos" />
                                    </children>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button fx:id="btnAyuda" onAction="#abrirAyuda" styleClass="menu-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <graphic>
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label styleClass="card-icon" text="❓" />
                                        <Label styleClass="card-text" text="Ayuda" />
                                    </children>
                                </VBox>
                            </graphic>
                        </Button>
                    </children>
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </children>
        </VBox>
    </center>
</BorderPane>
