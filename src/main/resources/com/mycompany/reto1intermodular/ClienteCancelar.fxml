<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="560.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto1intermodular.ClienteCancelarController">
   <children>
      <HBox alignment="CENTER" prefHeight="70.0">
         <children>
            <Label text="Buscar por:">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </Label>
            <TextField>
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </TextField>
            <Button mnemonicParsing="false" text="Buscar">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </Button>
            <Label text="Filtrar por:">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Label>
            <ComboBox prefWidth="150.0">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </ComboBox>
            <Button mnemonicParsing="false" text="Aplicar" />
         </children>
      </HBox>
      <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tbActividades" maxHeight="300.0" maxWidth="800.0" prefHeight="300.0" prefWidth="800.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="215.20001447200775" text="ID" />
                <TableColumn fx:id="colTipo" prefWidth="196.00001525878906" text="Tipo" />
                  <TableColumn fx:id="colImporte" prefWidth="219.99996948242188" text="Importe" />
                  <TableColumn fx:id="colEstado" prefWidth="166.4000244140625" text="Estado" />
              </columns>
            </TableView>
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefWidth="100.0" text="Cancelar">
               <HBox.margin>
                  <Insets left="40.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0">
         <children>
            <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#volver" prefWidth="100.0" text="Atras">
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
