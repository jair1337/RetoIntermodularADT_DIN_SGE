<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto1intermodular.ClienteCancelarController">
   <children>
      <HBox alignment="CENTER" prefHeight="70.0">
         <children>
            <Label text="Label">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </Label>
            <TextField>
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </TextField>
            <Button mnemonicParsing="false" text="Buscar">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
         <children>
            <TableView prefHeight="300.0" prefWidth="500.0">
              <columns>
                <TableColumn prefWidth="75.0" text="ID" />
                <TableColumn prefWidth="75.0" text="Actividad" />
                  <TableColumn prefWidth="75.0" text="Inicio" />
                  <TableColumn prefWidth="75.0" text="Fin" />
                  <TableColumn prefWidth="75.0" text="Precio" />
                  <TableColumn prefWidth="75.0" text="Aforo" />
              </columns>
            </TableView>
            <Button mnemonicParsing="false" prefWidth="100.0" text="Cancelar">
               <HBox.margin>
                  <Insets left="40.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0">
         <children>
            <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#volver" prefWidth="100.0" text="Atras">
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
