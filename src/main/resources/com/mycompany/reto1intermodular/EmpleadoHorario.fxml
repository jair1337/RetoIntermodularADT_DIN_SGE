<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="16.0" prefWidth="1000.0" prefHeight="560.0" styleClass="content-bg" stylesheets="@/styles/ApartadoLoginCSS.css" xmlns="http://javafx.com/javafx/9.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.reto1intermodular.EmpleadoHorarioController">
   <padding>
      <Insets top="24.0" right="36.0" bottom="24.0" left="36.0" />
   </padding>
   <children>
      <Label text="Horario de trabajo" styleClass="menu-title" />
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <DatePicker fx:id="dpFecha" promptText="Selecciona un día" />
            <Button text="Buscar" onAction="#buscar" styleClass="primary-btn" />
            <Button text="Mostrar todo" onAction="#mostrarTodo" styleClass="primary-btn" />
         </children>
      </HBox>
        <TableView fx:id="tablaHorario" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colActividad" prefWidth="440.0" text="Actividad o clase" />
            <TableColumn fx:id="colInicio" prefWidth="240.0" text="Inicio" />
            <TableColumn fx:id="colFin" prefWidth="240.0" text="Fin" />
         </columns>
      </TableView>
      <Button text="Atrás" onAction="#volver" styleClass="primary-btn" />
   </children>
</VBox>